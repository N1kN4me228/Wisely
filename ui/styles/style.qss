/* ============ БАЗА ============ */
* {
    font-family: "Uncage";
}

QWidget {
    background-color: #F6F9FC;
    color: #2C3580;
}

QLabel {
    background: transparent;
}

/* ============ ЗАГОЛОВКИ ============ */
#PageTitle {
    font-size: 26px;
    font-weight: bold;
    color: #2C3580;
    padding-bottom: 4px;
}

#RoleTitle {
    font-size: 42px;
    font-weight: bold;
    color: #2C3580;
    letter-spacing: 2px;
}

#RoleSubtitle {
    font-size: 17px;
    color: #5B6B8C;
}

#SubjectsPrefTitle {
    font-size: 24px;
    font-weight: bold;
    color: #2C3580;
}

#SubjectsPrefSubtitle {
    font-size: 14px;
    color: #5B6B8C;
}

/* ============ ШАПКА ОКНА ============ */
#TitleBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E4E9F2;
}

#TitleBarLabel {
    font-weight: bold;
    font-size: 14px;
    color: #2C3580;
    letter-spacing: 1px;
}

#CloseButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    color: #5B6B8C;
}

#CloseButton:hover {
    background-color: #FFC90F;
    color: #2C3580;
}

#LogoutButton {
    background: transparent;
    border: none;
    color: #5B6B8C;
    font-size: 13px;
    font-weight: bold;
    padding: 0 10px;
}

#LogoutButton:hover {
    color: #E0A800;
}

/* ============ ПЕРЕКЛЮЧАТЕЛЬ ЯЗЫКА ============ */
#LangSwitchButton, #LangButton {
    background-color: transparent;
    border: 1.5px solid #E4E9F2;
    border-radius: 8px;
    font-size: 11px;
    font-weight: bold;
    color: #5B6B8C;
}

#LangSwitchButton:hover, #LangButton:hover {
    border-color: #94E2F6;
}

#LangSwitchButton:checked, #LangButton:checked {
    background-color: #2C3580;
    color: #FFFFFF;
    border-color: #2C3580;
}

/* ============ SIDEBAR ============ */
#Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E4E9F2;
    min-width: 230px;
}

#SidebarButton {
    text-align: left;
    padding: 13px 18px;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 500;
    color: #5B6B8C;
    background-color: transparent;
}

#SidebarButton:hover {
    background-color: #EAF9FC;
    color: #2C3580;
}

#SidebarButton:checked {
    background-color: #2C3580;
    color: #FFFFFF;
    font-weight: bold;
}

/* ============ КНОПКИ РОЛИ (старт) ============ */
#RoleButton {
    background-color: #FFFFFF;
    border: 2px solid #E4E9F2;
    border-radius: 20px;
    font-size: 18px;
    font-weight: bold;
    color: #2C3580;
}

#RoleButton:hover {
    border-color: #94E2F6;
    background-color: #EAF9FC;
}

#RoleButton:pressed {
    background-color: #94E2F6;
}

/* ============ ОСНОВНЫЕ КНОПКИ ============ */
QPushButton#PrimaryButton {
    background-color: #2C3580;
    color: #FFFFFF;
    border-radius: 14px;
    padding: 12px 28px;
    font-size: 14px;
    font-weight: bold;
    border: none;
}

QPushButton#PrimaryButton:hover {
    background-color: #3B46A3;
}

QPushButton#PrimaryButton:pressed {
    background-color: #232A63;
}

QPushButton#PrimaryButton:disabled {
    background-color: #C7CEE8;
    color: #FFFFFF;
}

/* ============ ЧИПЫ ПРЕДМЕТОВ (preferences) ============ */
#SubjectChip {
    background-color: #FFFFFF;
    border: 2px solid #E4E9F2;
    border-radius: 14px;
    font-size: 14px;
    font-weight: 500;
    color: #2C3580;
}

#SubjectChip:hover {
    border-color: #94E2F6;
}

#SubjectChip:checked {
    background-color: #94E2F6;
    color: #2C3580;
    border-color: #2C3580;
    font-weight: bold;
}

/* ============ КАРТОЧКИ ПРЕДМЕТОВ ============ */
#SubjectCard {
    background-color: #FFFFFF;
    border: 1px solid #E4E9F2;
    border-radius: 18px;
}

#SubjectCard:hover {
    border-color: #94E2F6;
}

#SubjectCardName {
    font-size: 16px;
    font-weight: bold;
    color: #2C3580;
}

#SubjectCardProgress {
    border: none;
    border-radius: 8px;
    background-color: #EDF1F8;
    text-align: center;
    color: #2C3580;
    font-weight: bold;
}

#SubjectCardProgress::chunk {
    background-color: #2EC4B6;
    border-radius: 8px;
}

/* ============ СПИСОК ТЕМ ============ */
#BackButton {
    background: transparent;
    border: none;
    color: #2C3580;
    font-size: 14px;
    font-weight: bold;
}

#BackButton:hover {
    color: #94E2F6;
}

#TopicRow {
    background-color: #FFFFFF;
    border: 1px solid #E4E9F2;
    border-radius: 14px;
    text-align: left;
    padding: 0 22px;
    font-size: 15px;
    color: #2C3580;
}

#TopicRow:hover {
    border-color: #94E2F6;
    background-color: #EAF9FC;
}

/* ============ ЗАДАНИЯ ============ */
#TaskProgressLabel {
    font-size: 13px;
    color: #5B6B8C;
    font-weight: bold;
}

#TaskQuestion {
    font-size: 21px;
    color: #2C3580;
    background-color: #FFFFFF;
    border-radius: 14px;
    padding: 20px;
    border: 1px solid #E4E9F2;
}

#AnswerInput {
    border: 2px solid #E4E9F2;
    border-radius: 12px;
    padding: 12px;
    font-size: 15px;
    background-color: #FFFFFF;
    color: #2C3580;
}

#AnswerInput:focus {
    border-color: #94E2F6;
}

#CorrectAnswer {
    font-size: 16px;
    font-weight: bold;
    color: #2EC4B6;
    padding: 10px 0;
}

/* ============ AI CHECK ============ */
#PhotoPreview {
    background-color: #FFFFFF;
    border: 2px dashed #94E2F6;
    border-radius: 18px;
    color: #5B6B8C;
    font-size: 14px;
}

#ResultVerdict {
    font-size: 19px;
    font-weight: bold;
    color: #2EC4B6;
}

#ResultVerdict[status="warning"] {
    color: #E0A800;
}

/* ============ DASHBOARD ============ */
#RecommendationCard {
    background-color: #FFFFFF;
    border-left: 5px solid #FFC90F;
    border-radius: 12px;
    padding: 18px 22px;
    font-size: 15px;
    color: #2C3580;
}